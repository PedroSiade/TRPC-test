# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.turbo

# production
/build

# misc
.DS_Store
Thumbs.db
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# environment & secrets (never commit real values)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# keys & credential files
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
secrets.json
**/secrets/

# hosting / deploy tokens
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# Windows alternate data streams (e.g. Mark-of-the-Web)
*:Zone.Identifier
**/*:Zone.Identifier

# local editor / tooling (optional machine-specific)
.idea/
*.iml
